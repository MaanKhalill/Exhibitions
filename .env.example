# Copy this file to .env and fill in your Supabase project values.
# Find these in the Supabase dashboard: Project Settings -> API.
# The publishable (anon) key is safe to ship in a client app; row-level
# security in the database is what actually protects your data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-publishable-or-anon-key
